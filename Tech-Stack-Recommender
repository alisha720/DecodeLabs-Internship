from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
import csv

with open("raw_skills.csv", "r") as file:
    reader = csv.DictReader(file, skipinitialspace=True)
    data = list(reader)

print(data)
user_input = input("Enter your skills (comma separated): ")

print("Your skills:", user_input)
skill_texts = [row["skills"] for row in data]

vectorizer = TfidfVectorizer()
item_vectors = vectorizer.fit_transform(skill_texts)

user_vector = vectorizer.transform([user_input])
similarities = cosine_similarity(user_vector, item_vectors)[0]

for i, score in enumerate(similarities):
    data[i]["score"] = score

data.sort(key=lambda x: x["score"], reverse=True)

print("\nRecommended Roles:")
for row in data[:3]:
    print(row["role"], "-", round(row["score"], 2))
